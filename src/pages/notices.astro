---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import StatusBar from '../components/StatusBar.astro';
import Footer from '../components/Footer.astro';
import Flag from '../components/Flag.astro';
import { notices } from '../data/notices.js';

const fmt = (iso) =>
  new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/Chicago' })
    .format(new Date(`${iso}T12:00:00-05:00`));
---

<Layout title="Notices">
  <StatusBar placement="band" />
  <Header />
  <StatusBar placement="strip" />

  <main id="main">
    <div class="border-b border-acw-rule bg-acw-tint/40">
      <div class="mx-auto max-w-[880px] px-5 py-14 sm:px-8 sm:py-16">
        <h1 class="font-heading text-[32px] leading-tight font-medium text-acw-deep">Notices</h1>
        <p class="mt-3 max-w-[42rem] text-[17px] leading-relaxed text-acw-muted">
          Outages, water quality updates, required public notices, and anything else members need to
          know. During an outage or a boil water notice we post updates here as we get them.
        </p>
      </div>
    </div>

    <div class="mx-auto max-w-[880px] px-5 py-14 sm:px-8 sm:py-16">
      <ul class="space-y-10">
        {
          notices.map((notice) => (
            <li class="border-b border-acw-rule pb-10 last:border-0">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <time datetime={notice.date} class="text-[13px] text-acw-muted">{fmt(notice.date)}</time>
                <span class="text-acw-rule">&middot;</span>
                <span class="caps text-[11px] text-acw-green">{notice.kind}</span>
                {notice.flag && <Flag kind={notice.flag} />}
              </div>

              <h2 class="mt-2 font-heading text-[22px] leading-snug font-medium text-acw-deep">{notice.title}</h2>

              <div class="mt-3 space-y-3 text-[16px] leading-relaxed text-acw-ink">
                {notice.body.map((para) => <p>{para}</p>)}
              </div>
            </li>
          ))
        }
      </ul>

      {/* TODO: no pagination and no per-notice pages. Fine at three notices, not at thirty. */}
    </div>
  </main>

  <Footer />
</Layout>