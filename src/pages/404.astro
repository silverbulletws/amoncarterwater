---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import StatusBar from '../components/StatusBar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { contact } from '../data/nav.js';

const links = [
  { label: 'Notices', href: '/notices', note: 'Outages, advisories, and water quality updates' },
  { label: 'Water quality', href: '/#water-quality', note: 'The latest Consumer Confidence Report' },
  { label: 'Rates and fees', href: '/#rates-heading', note: 'What water costs and what it costs to connect' },
  { label: 'Service area', href: '/#service-area', note: 'See whether a property is inside our area' },
  { label: 'Start service', href: '/start-service', note: 'Apply for a new meter' },
  { label: 'Pay your bill', href: '/#pay-your-bill', note: 'By mail, by drop box, or by bank draft' },
];
---

<Layout title="Page not found">
  <StatusBar placement="band" />
  <Header />
  <StatusBar placement="strip" />

  <main id="main">
    <div class="border-b border-acw-rule bg-acw-tint/40">
      <div class="mx-auto max-w-[880px] px-5 py-16 sm:px-8 sm:py-20">
        <p class="caps text-[11px] text-acw-green">Error 404</p>
        <h1 class="mt-3 font-heading text-[32px] leading-tight font-medium text-acw-deep">
          We couldn't find that page
        </h1>
        <p class="mt-3 max-w-[42rem] text-[17px] leading-relaxed text-acw-muted">
          The link may be out of date, or the address may have a typo in it. Our old website was
          replaced, so older bookmarks and search results sometimes point at pages that no longer
          exist.
        </p>
        <a href="/" class="mt-10 inline-flex items-center gap-2 rounded-acw bg-acw-deep px-5 py-3 text-[15px] font-medium text-white transition-opacity hover:opacity-90">Go to the homepage<Icon name="arrow-right" class="h-4 w-4" /></a>
      </div>
    </div>

    <div class="mx-auto max-w-[880px] px-5 py-14 sm:px-8 sm:py-16">
      <h2 class="caps text-[11px] text-acw-green">Try one of these</h2>

      <ul class="mt-6 divide-y divide-acw-rule border-t border-acw-rule">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="group flex items-baseline justify-between gap-6 py-5">
                <span>
                  <span class="block font-heading text-[18px] font-medium text-acw-deep group-hover:underline">{link.label}</span>
                  <span class="mt-1 block text-[15px] text-acw-muted">{link.note}</span>
                </span>
                <Icon name="arrow-right" class="h-4 w-4 shrink-0 text-acw-green transition-transform group-hover:translate-x-0.5" />
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-10 rounded-acw-lg border border-acw-rule bg-acw-tint/40 p-6">
        <p class="text-[16px] leading-relaxed text-acw-ink">
          Still stuck? Call the office at
          <a href={contact.office.tel} class="font-medium text-acw-green hover:underline">{contact.office.display}</a>.
          For a leak or an emergency, call
          <a href={contact.emergency.tel} class="font-medium text-acw-green hover:underline">{contact.emergency.display}</a>
          any time.
        </p>
      </div>
    </div>
  </main>

  <Footer />
</Layout>