---
import Icon from './Icon.astro';
import { contact, quickLinks, identifiers } from '../data/nav.js';
import { board } from '../data/board.js';

const year = new Date().getFullYear();
---

<footer id="contact" class="bg-acw-deep text-acw-light">
  <div class="mx-auto max-w-[1240px] px-5 py-16 sm:px-8">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4 lg:gap-10">
      <!-- 1. Contact. Emergency first: the office is not staffed, so most -->
      <!--    urgent contact happens outside it.                            -->
      <div>
        <h2 class="caps text-[11px] text-acw-light/60">Contact</h2>

        <a href={contact.emergency.tel} class="mt-5 block group">
          <span class="block text-[12px] text-acw-light/70">
            {contact.emergency.label}
          </span>
          <span
            class="mt-1 block font-heading text-[24px] font-medium text-white group-hover:underline"
          >
            {contact.emergency.display}
          </span>
          <span class="mt-1 flex items-center gap-1.5 text-[13px] text-acw-mid">
            <span class="block h-2 w-2 rounded-full bg-acw-mid"></span>
            {contact.emergency.note}
          </span>
        </a>

        <a href={contact.office.tel} class="mt-6 block group">
          <span class="block text-[12px] text-acw-light/70">
            {contact.office.label}
          </span>
          <span class="mt-0.5 block text-[16px] text-white group-hover:underline">
            {contact.office.display}
          </span>
        </a>

        <a
          href={`mailto:${contact.email}`}
          class="mt-4 flex items-center gap-2 text-[15px] hover:text-white"
        >
          <Icon name="mail" class="h-4 w-4 shrink-0 text-acw-green" />
          {contact.email}
        </a>

        <div class="mt-5 flex gap-2 text-[14px] leading-relaxed text-acw-light/80">
          <Icon name="inbox" class="mt-0.5 h-4 w-4 shrink-0 text-acw-green" />
          <address class="not-italic">
            <span class="block text-acw-light/60">Mailing</span>
            {contact.mail.map((line) => <span class="block">{line}</span>)}
          </address>
        </div>

        <div class="mt-4 flex gap-2 text-[14px] leading-relaxed text-acw-light/80">
          <Icon name="map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-acw-green" />
          <address class="not-italic">
            <span class="block text-acw-light/60">Office</span>
            {contact.office_address.map((line) => <span class="block">{line}</span>)}
          </address>
        </div>
      </div>

      <!-- 2. Quick links -->
      <nav aria-label="Footer">
        <h2 class="caps text-[11px] text-acw-light/60">Quick links</h2>
        <ul class="mt-5 space-y-3">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.href} target={link.newTab ? '_blank' : undefined} rel={link.newTab ? 'noopener' : undefined} class="text-[15px] hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a href={contact.facebook.href} rel="noopener noreferrer" target="_blank" class="mt-6 inline-flex items-center gap-2.5 rounded-acw border border-acw-green px-4 py-2.5 text-[14px] font-medium text-white transition-colors hover:bg-acw-green"><Icon name="facebook" class="h-4 w-4" />{contact.facebook.label}</a>
      </nav>

      <!-- 3. About the corporation -->
      <div>
        <h2 class="caps text-[11px] text-acw-light/60">About the corporation</h2>
        <p class="mt-5 max-w-[26rem] text-[15px] leading-relaxed text-acw-light/80">
          A non-profit, member-owned and member-controlled corporation supplying
          Superior-rated potable water to members around Lake Amon Carter.
        </p>
        <dl class="mt-6 space-y-2 text-[14px]">
          <div class="flex gap-2">
            <dt class="text-acw-light/60">PUC CCN</dt>
            <dd class="text-white">{identifiers.ccn}</dd>
          </div>
          <div class="flex gap-2">
            <dt class="text-acw-light/60">TCEQ PWS</dt>
            <dd class="text-white">{identifiers.pws}</dd>
          </div>
          <div class="flex gap-2">
            <dt class="text-acw-light/60">County</dt>
            <dd class="text-white">{identifiers.county}</dd>
          </div>
        </dl>
      </div>

      <!-- 4. Board of Directors -->
      <div>
        <h2 class="caps text-[11px] text-acw-light/60">Board of Directors</h2>
        <ul class="mt-5 space-y-2.5 text-[14px]">
          {
            board.map((member) => (
              <li>
                <span class="block text-white">{member.name}</span>
                <span class="block text-[13px] text-acw-light/60">{member.role}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Bottom rule -->
    <div class="mt-14 border-t border-acw-green/40 pt-6 text-center text-[12.5px] text-acw-light/55">
      <p>&copy; {year} Amon Carter Lake Water Supply Corporation | Site created locally by <a href="https://silverbulletwebsolutions.com/" target="_blank" rel="noopener" class="transition-colors hover:text-white">Silver Bullet Web Solutions</a></p>
    </div>
  </div>
</footer>
