---
import Icon from './Icon.astro';

interface Props {
  /**
   * Optional full-bleed background photograph. The slot is wired up and ready:
   * pass a path and the darkened overlay comes with it. Until then the block
   * is flat --acw-deep, which is a finished look in its own right, not a
   * holding state.
   *
   * TODO: hero background image — awaiting the Lake Amon Carter photograph.
   * The best copy is on the old Water Quality page; the coverage map at
   * amoncarterwater.com/wp-content/uploads/2020/06/coveragemap.jpg suggests the
   * uploads folder is still reachable, so try there first.
   * Once recovered:  <Hero image="/images/lake-amon-carter.jpg" />
   */
  image?: string;
}

const { image } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-acw-deep">
  {
    image && (
      <>
<img
   src={image}
    alt=""
    aria-hidden="true"
    width="1920"
    height="1024"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_60%]"
/>
        {/* Light base wash — keeps the water bright */}
        <div class="absolute inset-0 -z-10 bg-black/30" />
        {/* Directional scrim — carries the text side only */}
        <div
          class="absolute inset-0 -z-10 bg-gradient-to-r from-acw-deep/85 via-acw-deep/45 to-transparent"
        />
     </>
     )
  }

  <div class="mx-auto max-w-[1240px] px-5 pt-20 pb-40 sm:px-8 sm:pt-28 sm:pb-48">
    <div class="max-w-[46rem]">
      {/* TODO: "Since 1995" is inferred from the old site — needs Kevin's confirmation. */}
      <p class="caps text-[11px] text-acw-light">
        Member-owned since 1995 &middot; Bowie, Texas
      </p>

      <h1
        class="mt-6 font-heading text-[34px] leading-[1.12] font-medium text-white sm:text-[40px] lg:text-[46px]"
      >
        Superior-rated potable water, delivered to your meter.
      </h1>

      <p class="mt-6 max-w-[38rem] text-[17px] leading-relaxed text-white/85">
        We purchase our water from the City of Bowie, and through our own
        equipment and lines, supply it to your meter.
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        {/* TODO: destination pending — /my-account */}
        <a
          href="#pay"
          class="inline-flex items-center gap-2 rounded-acw bg-white px-5 py-3 text-[15px] font-medium text-acw-deep transition-opacity hover:opacity-90"
        >
          Pay your bill
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>

        {/* TODO: destination pending — /start-service */}
        <a
          href="/start-service"
          class="inline-flex items-center gap-2 rounded-acw border border-white/70 bg-white/5 px-5 py-3 text-[15px] font-medium text-white backdrop-blur-[2px] transition-colors hover:border-white hover:bg-white/15"
        >
          Start service
        </a>
      </div>
    </div>
  </div>
</section>
