---
/**
 * Inline SVG icons, hand-authored in the Tabler style the brief names
 * (24×24 box, 2px stroke, round caps and joins). Inlined rather than pulled
 * from an icon package so the static build ships no icon font, no CDN request
 * and no JavaScript.
 *
 * Stroke and size are inherited: colour comes from `currentColor`, dimensions
 * from the `class` you pass (e.g. class="w-5 h-5").
 */

interface Props extends astroHTML.JSX.SVGAttributes {
  name: keyof typeof paths;
  class?: string;
  /** Decorative by default. Pass a label when the icon is the only content. */
  label?: string;
}

const paths = {
  droplet: '<path d="M12 3c0 0 6 7.2 6 11a6 6 0 0 1-12 0c0-3.8 6-11 6-11z" />',
  'droplet-off':
    '<path d="M12 3c0 0 6 7.2 6 11a6 6 0 0 1-12 0c0-3.8 6-11 6-11z" /><path d="M4 4l16 16" />',
  'alert-triangle':
    '<path d="M12 4.5l8.5 14.5h-17z" /><path d="M12 10v4" /><path d="M12 17v.01" />',
  'alert-octagon':
    '<path d="M9.5 3h5L21 9.5v5L14.5 21h-5L3 14.5v-5z" /><path d="M12 8v4.5" /><path d="M12 16v.01" />',
  'credit-card':
    '<rect x="3" y="6" width="18" height="12" rx="2" /><path d="M3 10.5h18" /><path d="M7 14.5h3" />',
  transfer: '<path d="M4 9h13l-3.5-3.5" /><path d="M20 15H7l3.5 3.5" />',
  map: '<path d="M9 4 3 7v13l6-3 6 3 6-3V4l-6 3-6-3z" /><path d="M9 4v13" /><path d="M15 7v13" />',
  'map-pin':
    '<path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z" /><circle cx="12" cy="10" r="2.5" />',
  phone:
    '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" />',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3.5 7.5l8.5 6 8.5-6" />',
  facebook:
    '<path d="M18 3h-3.5a5 5 0 0 0-5 5v3H6v4h3.5v6h4v-6h3l.5-4h-3.5V8a1 1 0 0 1 1-1H18z" />',
  menu: '<path d="M4 7h16" /><path d="M4 12h16" /><path d="M4 17h16" />',
  x: '<path d="M6 6l12 12" /><path d="M18 6L6 18" />',
  'arrow-right': '<path d="M5 12h13" /><path d="M13 6l6 6-6 6" />',
  file: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" />',
} as const;

const { name, class: className = 'w-5 h-5', label, ...rest } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  {...rest}
  set:html={paths[name]}
/>
