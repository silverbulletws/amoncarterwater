---
import Icon from './Icon.astro';

/**
 * Hairlines, not cards. The old homepage was one endless column; this is the
 * three things members actually arrive to do, given equal weight and divided
 * by rules rather than boxed up.
 *
 * TODO: every destination below is a placeholder — interior pages are out of
 * scope for this build.
 */
const tasks = [
  {
    icon: 'map',
    label: 'Service area',
    description: 'See what our certificated area covers, and how to request service.',
    href: '/#service-area',
  },
  {
    icon: 'credit-card',
    label: 'Pay your bill',
    description: 'View your balance, pay online, or set up a monthly bank draft.',
    href: '#pay-your-bill',
  },
  {
    icon: 'droplet',
    label: 'Water quality',
    description: 'Superior-rated water, tested year round. Read the latest report.',
    href: '/#water-quality',
  },
] as const;
---

<section aria-label="Common tasks" class="relative z-10">
  <div class="mx-auto -mt-28 max-w-[1240px] px-5 pb-8 sm:-mt-32 sm:px-8 sm:pb-10">
    <ul class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {
        tasks.map((task) => (
          <li>
            <a href={task.href} class="group flex h-full flex-col rounded-acw-lg border border-acw-light/25 bg-acw-green p-7 transition-colors hover:bg-acw-deep">
              <span class="flex h-11 w-11 items-center justify-center rounded-acw bg-white/10 text-acw-light">
                <Icon name={task.icon} class="h-5 w-5" />
              </span>

              <h2 class="mt-5 font-heading text-[19px] font-medium text-white">
                {task.label}
              </h2>

              <p class="mt-2 text-[15px] leading-relaxed text-acw-light/80">
                {task.description}
              </p>

              <span class="mt-5 inline-flex items-center gap-1.5 text-[14px] font-medium text-acw-light">
                Continue
                <Icon
                  name="arrow-right"
                  class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
                />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>