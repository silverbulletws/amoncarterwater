---
/**
 * Typed-name signature. Under ESIGN and the Texas UETA a typed name is a valid
 * electronic signature when the signer intends to sign, consents to doing
 * business electronically, and a reproducible record is kept. The script face
 * is presentation only — the legal weight is in the typed name, the consent
 * checkbox, and the timestamp captured on submit.
 *
 * TODO: for review by the corporation's attorney before go-live.
 */
interface Props {
  name: string;
  label?: string;
}
const { name, label = 'Signature' } = Astro.props;
---

<div class="rounded-acw-lg border border-acw-rule bg-acw-tint/30 p-6">
  <label for={name} class="block text-[15px] font-medium text-acw-deep">{label}</label>
  <p class="mt-1 text-[13px] text-acw-muted">Type your full legal name. This is your signature.</p>

  <input type="text" id={name} name={name} required autocomplete="name" data-sig-input class="mt-3 w-full rounded-acw border border-acw-rule bg-white px-4 py-3 text-[16px] text-acw-ink outline-none focus:border-acw-green" />

  <div class="mt-4 flex min-h-[72px] items-center rounded-acw border border-dashed border-acw-light bg-white px-5">
    <span data-sig-preview class="text-[30px] text-acw-deep" style="font-family: 'Dancing Script', cursive;">
      <span class="text-[15px] text-acw-muted" style="font-family: inherit;">Your signature will appear here</span>
    </span>
  </div>

  <label class="mt-4 flex gap-3 text-[14px] leading-relaxed text-acw-ink">
    <input type="checkbox" name={`${name}_consent`} required class="mt-1 h-4 w-4 shrink-0 accent-[#0F6E56]" />
    <span>I agree to sign this document electronically, and I understand my typed name has the same legal effect as a handwritten signature.</span>
  </label>

  <input type="hidden" name={`${name}_signed_at`} data-sig-time />
</div>

<script>
  const CURSIVE = "'Dancing Script', cursive";
  for (const input of document.querySelectorAll('[data-sig-input]')) {
    const box = input.closest('div');
    const preview = box?.querySelector('[data-sig-preview]');
    const stamp = box?.querySelector('[data-sig-time]');
    input.addEventListener('input', () => {
      const value = input.value.trim();
      if (!preview) return;
      if (value) {
        preview.textContent = value;
        preview.setAttribute('style', `font-family: ${CURSIVE}`);
        if (stamp) stamp.value = new Date().toISOString();
      } else {
        preview.innerHTML = '<span class="text-[15px] text-acw-muted">Your signature will appear here</span>';
        if (stamp) stamp.value = '';
      }
    });
  }
</script>